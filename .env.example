# Execution mode gates everything the engine is allowed to do with a broker.
# SHADOW (default) logs intents and submits nothing. PAPER/LIVE are unreachable
# until the Story 5 startup assertions and Story 13 capital values are in place.
EXECUTION_MODE=SHADOW

# Backend HTTP port. The UI's NEXT_PUBLIC_API_URL must agree with this.
PORT=3000

# Where the dashboard finds the backend.
#
# `API_URL` is the one that actually takes effect: the dashboard is a Server
# Component and every control is a Server Action, so the fetch originates on the
# Next.js server rather than in the browser (`ui/app/lib/api.ts`). Compose sets
# it to `http://backend:3000`, the backend's service name on the compose network
# — `localhost` there would resolve to the ui container itself.
#
# `NEXT_PUBLIC_API_URL` is only a fallback, read when `API_URL` is unset.
#
# **Both are deliberately commented out.** Compose already defaults API_URL to
# `http://backend:3000` and a value set here overrides that
# (`docker-compose.yml`) — so uncommenting `localhost:3000` would point the ui
# container at *itself* and break every panel on the dashboard. Set these only
# when running the dashboard outside compose, where localhost is correct.
#API_URL=http://localhost:3000
#NEXT_PUBLIC_API_URL=http://localhost:3000

# MySQL connection (Story 8). Its **presence is the switch**: set it and the
# engine binds the Prisma repositories, so lots, rungs, and the parameter audit
# trail survive a restart; leave it unset and the in-memory repositories are
# used and all state is lost on exit. `GET /status` reports which is live.
#
# **Commented out, and compose does not read it anyway**: the backend service
# builds its own DSN against the `mysql` service name, so durable storage works
# under `docker compose up` with no value here. This line is for running the
# backend *outside* a container against the compose database — hence 127.0.0.1
# rather than the `mysql` hostname, which only resolves on the compose network,
# and the published port below rather than 3306.
#DATABASE_URL=mysql://ib:ib_password@127.0.0.1:3307/ib

# Host port the compose MySQL is published on. 3307 because 3306 is usually
# already taken by a locally installed MySQL, and the collision is silent from
# the client's side: a DATABASE_URL on 3306 simply reaches the wrong database.
# Only affects host access — the backend container reaches `mysql:3306`.
#MYSQL_HOST_PORT=3307

# Credentials the MySQL container is created with. Local development values —
# the database is not exposed beyond the compose network.
MYSQL_ROOT_PASSWORD=ib_root
MYSQL_DATABASE=ib
MYSQL_USER=ib
MYSQL_PASSWORD=ib_password

# --- IB Gateway (Story 10) ---------------------------------------------------
# Presence of IB_HOST is the switch that selects the real IB broker over the
# mock, mirroring how DATABASE_URL selects durable storage. Leave it unset and
# the engine runs on mock data with zero external dependencies; set it and the
# backend connects to IB Gateway. `GET /status` reports which broker is live.
#
# This does NOT enable order submission — EXECUTION_MODE governs that, and
# SHADOW submits nothing whichever broker is bound.
#
# Two ways to reach IB:
#   host.docker.internal — Gateway/TWS running as a desktop app (the default,
#                          and the simpler one: the login already works)
#   ib-gateway           — the containerized gateway, which only starts with
#                          `docker compose --profile ib-gateway up`
#
# **Deliberately commented out.** This file gets copied verbatim, and a value
# here selects the IB adapter — so an operator who copies it without a running,
# logged-in Gateway gets a broker that cannot connect (`connect failed`, then a
# BROKER_UNAVAILABLE halt) rather than the working mock-data path. Uncomment it
# only when a Gateway is actually up; see the README's "Connecting to
# Interactive Brokers".
#IB_HOST=host.docker.internal

# **4001 = LIVE account, 4002 = paper.** (TWS uses 7496 live / 7497 paper.)
# 4002 here on purpose: Story 10 runs in SHADOW and submits nothing, so the
# port only decides which account's data is read — and until Story 13 there is
# no reason for that to be the funded one. Changing this to 4001 points the
# engine at live account data; do it deliberately, not by copying a default.
IB_PORT=4002

# IB rejects two simultaneous connections sharing a client id. If a desktop
# Gateway, a notebook, or another bot is already connected as 1, give this one
# its own number or both will drop.
IB_CLIENT_ID=1

# --- Containerized gateway only (`--profile ib-gateway`) ---------------------
# Ignored entirely when IB_HOST=host.docker.internal — a desktop Gateway
# handles its own login.
#
# **Never commit real values** — copy this file to `.env`, which .gitignore
# excludes. Without them the container cannot authenticate.
TWS_USERID=
TWS_PASSWORD=

# `paper` or `live`. Kept at paper: Story 10 submits nothing, but if that ever
# changes by mistake the account it reaches should not be the funded one.
TRADING_MODE=paper

# IB Gateway logs itself out daily by design; IBC restarts it at this ET time,
# chosen to sit outside market hours so the routine re-auth costs no bars.
TWS_COLD_RESTART=04:00
TIME_ZONE=America/New_York

# Refuses order submission at the gateway itself — defence in depth beneath
# EXECUTION_MODE. Set to `no` only at Story 13, when PAPER is enabled.
READ_ONLY_API=yes
